#!/usr/bin/env bash
# Starts the bot's desktop as the bot user: a virtual screen, a window manager,
# a panel with an app menu, Chromium and TigerVNC. Everything listens on
# localhost only. The script exits when one part exits, and the server starts it again.
#
# The server runs it through sudo, which allows no arguments.
#
# Chromium gets its profile, its DevTools port and the network gate from
# /etc/chromium.d/cloudbot, see docker/chromium-flags. So a Chromium started
# from the app menu or a terminal opens a window in this same browser.

set -euo pipefail

DISPLAY_NUMBER=1
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800
SCREEN_DEPTH=24
VNC_PORT=5900
PANEL_CONFIG=/usr/local/share/cloudbot/tint2rc
STATE_DIR="$HOME/.cache/cloudbot-desktop"
LOG_FILE="$STATE_DIR/desktop.log"
# The same folder as --user-data-dir in docker/chromium-flags.
PROFILE_DIR="$HOME/.config/cloudbot-chromium"
LOCK_FILE="/tmp/cloudbot-desktop.lock"
X_SOCKET="/tmp/.X11-unix/X$DISPLAY_NUMBER"
X_LOCK="/tmp/.X$DISPLAY_NUMBER-lock"
CHILD_PIDS=()

export DISPLAY=":$DISPLAY_NUMBER"
# Apps opened from the panel start in the bot home and read and write UTF-8.
export LANG=C.UTF-8

mkdir -p "$STATE_DIR" "$PROFILE_DIR"
cd "$HOME"

# One desktop at a time. A second start fails at once. The children close
# descriptor 9 (9>&-), so parts left over after a crash do not hold the lock.
exec 9> "$LOCK_FILE"
if ! flock -n 9; then
    echo "The desktop is already running." >&2
    exit 1
fi

# The log starts empty on each start so it cannot grow without end.
: > "$LOG_FILE"

# shellcheck disable=SC2329 # Called by the EXIT trap below.
stop_children() {
    if [ "${#CHILD_PIDS[@]}" -gt 0 ]; then
        kill "${CHILD_PIDS[@]}" 2>/dev/null || true
        wait 2>/dev/null || true
    fi
    pkill -u "$(id -u)" -f -- "--user-data-dir=$PROFILE_DIR" || true
}

# The server and this script share a process group, so only the started children are stopped.
trap stop_children EXIT
trap 'exit 0' TERM INT

# A crash can leave parts of an old desktop running, plus the X lock and
# Chromium's profile locks. The flock above proves that no other desktop
# script is running, so all of them are stale.
pkill -u "$(id -u)" -f "^Xtigervnc :$DISPLAY_NUMBER " || true
pkill -u "$(id -u)" -f -- "--user-data-dir=$PROFILE_DIR" || true
rm -f "$X_LOCK" "$X_SOCKET"
rm -f "$PROFILE_DIR/SingletonLock" "$PROFILE_DIR/SingletonSocket" "$PROFILE_DIR/SingletonCookie"

Xtigervnc ":$DISPLAY_NUMBER" \
    -geometry "${SCREEN_WIDTH}x${SCREEN_HEIGHT}" \
    -depth "$SCREEN_DEPTH" \
    -localhost \
    -SecurityTypes None \
    -rfbport "$VNC_PORT" \
    -AlwaysShared=1 \
    -AcceptSetDesktopSize=1 >> "$LOG_FILE" 2>&1 9>&- &
CHILD_PIDS+=("$!")

for _attempt in $(seq 50); do
    [ -S "$X_SOCKET" ] && break
    sleep 0.1
done
if [ ! -S "$X_SOCKET" ]; then
    echo "The virtual screen did not start. See $LOG_FILE." >&2
    exit 1
fi

openbox >> "$LOG_FILE" 2>&1 9>&- &
CHILD_PIDS+=("$!")

# The empty desktop has the dark color of the app, not black.
xsetroot -solid '#1b1b1f' || true

# The panel holds the app menu, a terminal and the browser, and a button for each open window.
# Apps open from the menu run as bot in this desktop and stay open after a turn ends.
tint2 -c "$PANEL_CONFIG" >> "$LOG_FILE" 2>&1 9>&- &
CHILD_PIDS+=("$!")

# Chromium starts again a second after it closes, since the browser tools need it.
maximize_browser() {
    local window_id

    for _attempt in $(seq 50); do
        window_id="$(wmctrl -l -x | awk 'tolower($0) ~ /chromium/ { print $1; exit }')"

        if [ -n "$window_id" ] && wmctrl -i -r "$window_id" -b add,maximized_vert,maximized_horz; then
            return 0
        fi
        sleep 0.1
    done

    return 1
}

run_browser() {
    while :; do
        chromium --window-position=0,0 --start-maximized https://www.google.com/ >> "$LOG_FILE" 2>&1 9>&- &
        local browser_pid=$!

        if ! maximize_browser; then
            echo "The Chromium window could not be maximized." >> "$LOG_FILE"
        fi

        wait "$browser_pid" || true
        sleep 1
    done
}

run_browser &
CHILD_PIDS+=("$!")

echo "The desktop is running on display $DISPLAY."

# Checks every part once a second and exits when one is gone. wait -n would miss
# a part that exited before the script reached it.
while :; do
    for child_pid in "${CHILD_PIDS[@]}"; do
        if ! kill -0 "$child_pid" 2>/dev/null; then
            echo "A desktop process exited. See $LOG_FILE." >&2
            exit 1
        fi
    done
    # A background sleep lets the TERM trap run at once.
    sleep 1 &
    wait "$!"
done
