#!/bin/sh
# Runs the agent CLI of one provider for CloudBot as the bot user, see src/server/providers/acpProviders.ts.
# Only fixed commands are allowed: `acp` starts the ACP server and `login` starts the sign-in. No argument of the
# server reaches the CLI. Each CLI keeps its sign-in in the bot home, which is a volume, so it survives a rebuild.
set -eu

provider="${1:-}"
action="${2:-}"

if [ "$#" -ne 2 ] || { [ "$action" != "acp" ] && [ "$action" != "acp-key" ] && [ "$action" != "login" ] && [ "$action" != "status" ] && [ "$action" != "agy" ]; }; then
    echo "cloudbot-provider takes a provider and acp, acp-key, agy, login or status." >&2
    exit 2
fi

umask 077
# The CLIs are root-owned copies, so an update check could only fail. These turn it off where the CLI offers it.
export NO_UPDATE_NOTIFIER=1 OPENCODE_DISABLE_AUTOUPDATE=1 COPILOT_AUTO_UPDATE=false KIMI_CODE_NO_AUTO_UPDATE=1
# Kimi Code can schedule prompts with CronCreate. A schedule would run outside CloudBot's turns, so it is off.
export KIMI_DISABLE_CRON=1
# A CLI that wants to open a browser prints the link instead, which the server reads from the sign-in output.
export BROWSER=/usr/local/bin/cloudbot-print-url NO_BROWSER=true NO_OPEN_BROWSER=1
LOGIN=/usr/local/lib/cloudbot/acp-login.js

case "$provider:$action" in
    gemini:acp) exec /usr/local/bin/gemini --acp ;;
    # Google ended Gemini CLI sign-ins for individuals, so a Gemini subscription signs in to the Antigravity CLI.
    gemini:login) exec /usr/local/bin/node /usr/local/lib/cloudbot/agy-login.js ;;
    gemini:status) exec /usr/local/bin/node /usr/local/lib/cloudbot/agy-login.js --status ;;
    # A Gemini subscription runs on agy headless. Its PreToolUse hook sends each tool call to the CloudBot review of the
    # turn, and the bot tools come from the loopback server. The server sets only the loopback address, the turn token,
    # and optionally a conversation id, a model slug and an effort, and each is checked here.
    gemini:agy)
        case "${CLOUDBOT_AGY_REVIEW_URL:-}" in
            http://127.0.0.1:[0-9]*/mcp) ;;
            *)
                echo "cloudbot-provider needs the review address." >&2
                exit 2
                ;;
        esac
        port="${CLOUDBOT_AGY_REVIEW_URL#http://127.0.0.1:}"
        port="${port%/mcp}"
        case "$port" in
            ''|*[!0-9]*)
                echo "cloudbot-provider needs the review address." >&2
                exit 2
                ;;
        esac
        case "${CLOUDBOT_TOOLS_TOKEN:-}" in
            ''|*[!0-9a-f]*)
                echo "cloudbot-provider needs the turn token." >&2
                exit 2
                ;;
        esac
        mkdir -p "$HOME/.gemini/config"
        printf '%s\n' '{"cloudbot-review":{"PreToolUse":[{"matcher":"","hooks":[{"type":"command","command":"/usr/local/bin/node /usr/local/lib/cloudbot/agy-hook.js","timeout":3900}]}]}}' > "$HOME/.gemini/config/hooks.json"
        /usr/local/bin/agy mcp add --header "Authorization: Bearer $CLOUDBOT_TOOLS_TOKEN" cloudbot "http://127.0.0.1:$port/mcp" > /dev/null 2>&1 || true
        set --
        case "${CLOUDBOT_AGY_CONVERSATION:-}" in
            '') ;;
            *[!0-9a-f-]*) ;;
            *) set -- --conversation "$CLOUDBOT_AGY_CONVERSATION" ;;
        esac
        case "${CLOUDBOT_AGY_MODEL:-}" in
            '') ;;
            *[!a-z0-9.-]*) ;;
            *) set -- "$@" --model "$CLOUDBOT_AGY_MODEL" ;;
        esac
        case "${CLOUDBOT_AGY_EFFORT:-}" in
            low|medium|high|xhigh|max) set -- "$@" --effort "$CLOUDBOT_AGY_EFFORT" ;;
        esac
        exec /usr/local/bin/agy --input-format stream-json --output-format stream-json --print-timeout 0 "$@"
        ;;
    copilot:acp) exec /usr/local/bin/copilot --acp --stdio ;;
    copilot:login) exec /usr/local/bin/copilot login --device-code ;;
    cursor:acp) exec /usr/local/bin/cursor-agent acp ;;
    cursor:login) exec /usr/local/bin/cursor-agent login ;;
    grok:acp) exec /usr/local/bin/grok --no-auto-update agent stdio ;;
    grok:login) exec /usr/local/bin/grok login --device-auth ;;
    mistral:acp) exec /usr/local/bin/vibe-acp ;;
    mistral:login) exec /usr/local/bin/node "$LOGIN" browser-auth /usr/local/bin/vibe-acp ;;
    kimi:acp) exec /usr/local/bin/kimi acp ;;
    kimi:login) exec /usr/local/bin/kimi login ;;
    qwen:acp) exec /usr/local/bin/qwen --acp --auth-type openai ;;
    # opencode asks before every tool, so each call goes to the CloudBot review.
    opencode:acp)
        export OPENCODE_CONFIG_CONTENT='{"permission":{"*":"ask"},"autoupdate":false}'
        exec /usr/local/bin/opencode acp
        ;;
    # Grok Build signs in only with a Grok account over ACP, so an xAI API key runs through opencode's xAI provider.
    # The key proxy adds the real key. The server sets only the proxy address, which must be a loopback port.
    grok:acp-key)
        case "${CLOUDBOT_KEY_PROXY_URL:-}" in
            http://127.0.0.1:[0-9]*) ;;
            *)
                echo "cloudbot-provider needs the key proxy address." >&2
                exit 2
                ;;
        esac
        port="${CLOUDBOT_KEY_PROXY_URL#http://127.0.0.1:}"
        case "$port" in
            *[!0-9]*)
                echo "cloudbot-provider needs the key proxy address." >&2
                exit 2
                ;;
        esac
        export OPENCODE_CONFIG_CONTENT="{\"permission\":{\"*\":\"ask\"},\"autoupdate\":false,\"model\":\"xai/grok-4.7\",\"provider\":{\"xai\":{\"options\":{\"baseURL\":\"http://127.0.0.1:$port/v1\",\"apiKey\":\"cloudbot-key-proxy\"}}}}"
        exec /usr/local/bin/opencode acp
        ;;
    *)
        echo "cloudbot-provider does not know $provider $action." >&2
        exit 2
        ;;
esac