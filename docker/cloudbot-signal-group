#!/bin/sh
# Signals one process group of the agent user. The server runs it through sudo, see cloudbot-agent.sudoers.
# It takes a positive group id and TERM or KILL, and nothing else.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: cloudbot-signal-group <group id> TERM|KILL" >&2
    exit 2
fi

case "$1" in
    ''|*[!0-9]*|0*)
        echo "invalid group id" >&2
        exit 2
        ;;
esac

case "$2" in
    TERM|KILL) ;;
    *)
        echo "invalid signal" >&2
        exit 2
        ;;
esac

exec /bin/kill -s "$2" -- "-$1"
