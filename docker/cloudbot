#!/usr/bin/env bash
# Runs CloudBot on this server. install.sh links it as /usr/local/bin/cloudbot.
#
# Usage: sudo cloudbot <status|logs|update [--all]|install-update|reset-password [name]|uninstall>

set -euo pipefail

find_home() {
    local script_path
    local candidate

    script_path="$(readlink -f "$0")"
    candidate="$(dirname "$(dirname "$script_path")")"

    if [ -f "$candidate/docker/compose.yaml" ]; then
        printf '%s' "$candidate"
    else
        printf '%s' "/opt/cloudbot"
    fi
}

CLOUDBOT_HOME="${CLOUDBOT_HOME:-$(find_home)}"
COMMAND_PATH="/usr/local/bin/cloudbot"
UPDATE_STATE_DIR="/var/lib/cloudbot-update"
SYSTEMD_DIR="/etc/systemd/system"

usage() {
    cat <<'EOF'
Usage: sudo cloudbot <command>

Commands:
  status                 Show the hub, proxy, Caddy and instances with memory use
  logs                   Follow the hub logs (Ctrl+C to stop)
  update [--all]         Pull the latest code and rebuild the hub image. --all also
                         removes the instance containers that use an old image
  install-update         Let the owner start an update from the web app
  reset-password [name]  Print a new password for a person (default owner)
  uninstall [--keep-data] [--yes]
                         Remove CloudBot. --keep-data leaves the volumes and the install
                         folder. --yes skips the question
EOF
}

compose() {
    docker compose -f "$CLOUDBOT_HOME/docker/compose.yaml" --env-file "$CLOUDBOT_HOME/.env" "$@"
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "error: run as root, for example: sudo cloudbot $1" >&2
        exit 1
    fi
}

command_status() {
    compose ps hub docker-proxy caddy
    docker ps --filter name=cloudbot-i-
    docker ps -q --filter name=cloudbot-i- | xargs --no-run-if-empty docker stats --no-stream
}

command_logs() {
    compose logs --follow --tail=200 hub | sed -E 's/(Owner [^ ]+ password: ).*/\1[redacted]/'
}

# The Google client lines of an environment, sorted, so two environments can be compared. Empty lines are left out.
google_client_lines() {
    grep -E '^CLOUDBOT_GOOGLE_CLIENT_(ID|SECRET)=.+' | sort || true
}

# Removes every instance container that does not use the current image or the Google client that the hub
# has now. The cbi-* volumes stay and the hub creates each container again on the next request.
remove_outdated_instances() {
    local image_id
    local hub_client
    local container

    image_id="$(docker image inspect --format '{{.Id}}' cloudbot:local)"
    hub_client="$(compose exec -T hub env | google_client_lines)"

    docker ps -a --filter name=^cloudbot-i- --format '{{.Names}}' | while read -r container; do
        local container_client
        container_client="$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" | google_client_lines)"

        if [ "$(docker inspect --format '{{.Image}}' "$container")" != "$image_id" ] || [ "$container_client" != "$hub_client" ]; then
            docker rm -f "$container"
        fi
    done
}

# Frees the disk after an update. Images no tag points to are removed, and so is build cache older than one day.
# An image that a running instance still uses stays, so run it after remove_outdated_instances.
prune_old_images() {
    docker image prune -f
    docker builder prune -f --filter until=24h
}

command_update() {
    local moves_instances="false"

    if [ "${1:-}" = "--all" ]; then
        moves_instances="true"
    elif [ "$#" -gt 0 ]; then
        usage >&2
        exit 1
    fi

    git -C "$CLOUDBOT_HOME" pull --ff-only
    compose pull docker-proxy caddy
    compose build hub
    compose up -d --force-recreate hub docker-proxy caddy

    if [ "$moves_instances" = "true" ]; then
        remove_outdated_instances
        prune_old_images
        echo "Instances on an old image were removed. The hub creates each one from the new image on the next request."
        return
    fi

    prune_old_images

    cat <<'EOF'
Running instances keep their old image until recreated. To move all of them to
this image, run:

  sudo cloudbot update --all

Their cbi-* volumes remain. The hub creates each one from the new image on the next request.
EOF
}

hub_data_dir() {
    docker volume inspect hub-data --format '{{.Mountpoint}}'
}

# Tells the hub the state of the update. The hub user owns the folder, so the file is made elsewhere and moved in. A rename
# never follows a link, so that user cannot point this root write at another file.
write_update_status() {
    local state="$1"
    local commit
    local latest
    local temp_file

    commit="$(git -C "$CLOUDBOT_HOME" rev-parse HEAD)"
    latest="$(git -C "$CLOUDBOT_HOME" rev-parse '@{upstream}' 2>/dev/null || printf '%s' "$commit")"
    mkdir -p "$UPDATE_STATE_DIR"
    temp_file="$(mktemp "$UPDATE_STATE_DIR/status.XXXXXX")"
    printf '{"state":"%s","commit":"%s","latest":"%s","at":"%s"}\n' "$state" "$commit" "$latest" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$temp_file"
    chmod 644 "$temp_file"
    mv -fT "$temp_file" "$(hub_data_dir)/update-status.json"
}

# Started by systemd when the hub leaves a request file. Only the file's presence counts. Its content is never read.
# The update runs as its own process, so a failure in it stops it as it does when run by hand.
command_update_from_request() {
    rm -f "$(hub_data_dir)/update-request"
    write_update_status running

    if "$COMMAND_PATH" update --all; then
        write_update_status "done"
    else
        write_update_status failed
    fi
}

# Started by a systemd timer, so the web app can say when a new version is out. It keeps the result of the last update.
command_check_update() {
    local previous

    if systemctl is-active --quiet cloudbot-update.service; then
        return 0
    fi

    git -C "$CLOUDBOT_HOME" fetch --quiet
    previous="$(sed -n -E 's/.*"state":"(done|failed)".*/\1/p' "$(hub_data_dir)/update-status.json" 2>/dev/null || true)"
    write_update_status "${previous:-idle}"
}

command_install_update() {
    if ! command -v systemctl > /dev/null; then
        echo "This server has no systemd, so updates run only with: sudo cloudbot update --all"
        return 0
    fi

    cat > "$SYSTEMD_DIR/cloudbot-update.path" <<EOF
[Unit]
Description=Watch for an update request from the CloudBot web app

[Path]
PathExists=$(hub_data_dir)/update-request

[Install]
WantedBy=multi-user.target
EOF
    cat > "$SYSTEMD_DIR/cloudbot-update.service" <<EOF
[Unit]
Description=Update CloudBot

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=$COMMAND_PATH update-from-request
EOF
    cat > "$SYSTEMD_DIR/cloudbot-update-check.service" <<EOF
[Unit]
Description=Check for a new CloudBot version

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=$COMMAND_PATH check-update
EOF
    cat > "$SYSTEMD_DIR/cloudbot-update-check.timer" <<EOF
[Unit]
Description=Check for a new CloudBot version every hour

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable --now cloudbot-update.path cloudbot-update-check.timer
    command_check_update
    echo "The owner can now update CloudBot from the web app."
}

remove_update_service() {
    if command -v systemctl > /dev/null; then
        systemctl disable --now cloudbot-update.path cloudbot-update-check.timer 2>/dev/null || true
    fi

    rm -f "$SYSTEMD_DIR/cloudbot-update.path" "$SYSTEMD_DIR/cloudbot-update.service" "$SYSTEMD_DIR/cloudbot-update-check.service" "$SYSTEMD_DIR/cloudbot-update-check.timer"
    rm -rf "$UPDATE_STATE_DIR"
}

command_reset_password() {
    local person_name="${1:-owner}"
    compose exec -T hub node dist/hub/main.js reset-password "$person_name"
}

command_uninstall() {
    local is_confirmed="false"
    local keeps_data="false"
    local argument
    local answer
    local command_target

    for argument in "$@"; do
        case "$argument" in
            --yes)
                is_confirmed="true"
                ;;
            --keep-data)
                keeps_data="true"
                ;;
            *)
                usage >&2
                exit 1
                ;;
        esac
    done

    if [ ! -f "$CLOUDBOT_HOME/docker/compose.yaml" ]; then
        echo "error: no CloudBot install found in $CLOUDBOT_HOME" >&2
        exit 1
    fi

    if [ "$keeps_data" = "true" ]; then
        echo "This removes the CloudBot containers, networks and image. Volumes and $CLOUDBOT_HOME stay."
    else
        echo "This removes CloudBot, every person's data and $CLOUDBOT_HOME. It cannot be undone."
        echo "Back up the hub-data and cbi-* volumes first if you need them (see docs/INSTALL.md)."
    fi

    if [ "$is_confirmed" != "true" ]; then
        read -r -p "Type uninstall to continue: " answer

        if [ "$answer" != "uninstall" ]; then
            echo "Cancelled."
            exit 1
        fi
    fi

    remove_update_service
    docker ps -aq --filter name=^cloudbot-i- | xargs --no-run-if-empty docker rm -f

    if [ "$keeps_data" = "true" ]; then
        compose down
    else
        compose down --volumes
    fi

    docker network ls -q --filter name=^cloudbot-net- | xargs --no-run-if-empty docker network rm
    docker image rm cloudbot:local 2>/dev/null || true

    command_target="$(readlink "$COMMAND_PATH" || true)"

    if [ "$command_target" = "$CLOUDBOT_HOME/docker/cloudbot" ]; then
        rm -f "$COMMAND_PATH"
    fi

    if [ "$keeps_data" != "true" ]; then
        docker volume ls -q --filter name=^cbi- | xargs --no-run-if-empty docker volume rm
        rm -rf "$CLOUDBOT_HOME"
    fi

    echo "CloudBot removed. Docker itself stays installed."
}

main() {
    local command="${1:-}"

    case "$command" in
        "" | -h | --help | help)
            usage
            ;;
        status)
            require_root "$command"
            command_status
            ;;
        logs)
            require_root "$command"
            command_logs
            ;;
        update)
            require_root "$command"
            shift
            command_update "$@"
            ;;
        install-update)
            require_root "$command"
            command_install_update
            ;;
        update-from-request)
            require_root "$command"
            command_update_from_request
            ;;
        check-update)
            require_root "$command"
            command_check_update
            ;;
        reset-password)
            require_root "$command"
            if [ "$#" -gt 2 ]; then
                usage >&2
                exit 1
            fi
            command_reset_password "${2:-owner}"
            ;;
        uninstall)
            require_root "$command"
            shift
            command_uninstall "$@"
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
