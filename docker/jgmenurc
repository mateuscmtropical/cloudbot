# The app menu of the bot's desktop, installed as /usr/local/share/cloudbot/jgmenurc.
# The apps module reads the desktop entries each time the menu opens, so an app installed later is listed.
csv_cmd = apps
stay_alive = 0
position_mode = ipc
tint2_look = 0
menu_width = 260
menu_padding_top = 6
menu_padding_bottom = 6
menu_radius = 4
menu_border = 0
item_height = 30
item_padding_x = 10
item_radius = 4
font = sans 10
icon_size = 22
icon_theme = Adwaita
color_menu_bg = #1b1b1f 100
color_norm_bg = #1b1b1f 0
color_norm_fg = #eeeeee 100
color_sel_bg = #45455a 100
color_sel_fg = #ffffff 100
color_sep_fg = #3a3a44 100
