{
  "name": "cloudbot",
  "version": "0.0.0",
  "private": true,
  "description": "Your own always-on AI coworker on your VPS, powered by Claude.",
  "license": "MIT",
  "author": "Mateus Silva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuscmtropical/cloudbot.git"
  },
  "bugs": {
    "url": "https://github.com/mateuscmtropical/cloudbot/issues"
  },
  "homepage": "https://github.com/mateuscmtropical/cloudbot#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsup && vite build",
    "db:generate": "drizzle-kit generate",
    "dev": "node --watch --experimental-strip-types src/server/main.ts",
    "start": "node dist/server/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
